# 複製成 .env 後填入。
# 注意：Web 設定頁寫入的 config.json 優先序高於本檔（config.json > 環境變數 > .env）。

# Web 伺服器綁定
SNAPMAN_WEB_HOST=0.0.0.0
SNAPMAN_WEB_PORT=8070

# vCenter 連線（SIMULATION=false 才會用到）
SNAPMAN_VCENTER_HOST=vcenter.example.local
SNAPMAN_VCENTER_USER=administrator@vsphere.local
SNAPMAN_VCENTER_PASSWORD=
SNAPMAN_VCENTER_INSECURE=true

# Guest（VM 內）憑證：透過 VMware Tools Guest Operations 執行指令用
SNAPMAN_GUEST_USER=Administrator
SNAPMAN_GUEST_PASSWORD=

# AD（NTLM）登入（ad_enabled=false 時僅本機管理員 admin 可登入；密碼首次啟動自動產生於 data/initial_admin_password.txt）
SNAPMAN_AD_ENABLED=false
SNAPMAN_AD_DOMAIN=
SNAPMAN_AD_SERVICE_USER=
SNAPMAN_AD_SERVICE_PASSWORD=
SNAPMAN_AD_ALLOWED_GROUP=
SNAPMAN_AD_BASE_DN=

# 資料庫（預設 SQLite 檔）
SNAPMAN_DATABASE_URL=sqlite:///./data/snapman.db
